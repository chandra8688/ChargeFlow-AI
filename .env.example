# ChargeFlow AI V2 — Environment Variables Example
# Copy this file to .env or set environment variables in your deployment environment.

# Optional: Google Gemini API Key for Phase 6 RAG Knowledge Assistant answer generation.
# If omitted, RAG document retrieval still operates, but answer generation reports unconfigured.
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: Google Gemini Model name (defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
